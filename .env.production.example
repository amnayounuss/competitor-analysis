# ═══ Production — Self-Hosted Supabase ═══
# Copy to .env and fill in. Same docker/scripts/setup.sh keys, different URL.

# ── Supabase (self-hosted, behind reverse proxy with SSL) ───
NEXT_PUBLIC_SUPABASE_URL=https://supabase.yourdomain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from setup.sh output>
SUPABASE_SERVICE_ROLE_KEY=<from setup.sh output>

# ── Google APIs ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
# GMB_OAUTH_CLIENT_ID=
# GMB_OAUTH_CLIENT_SECRET=

# ── Scraping ────────────────────────────────────────────────
APIFY_TOKEN=

# ── AI (Anthropic Claude) ──────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Email ───────────────────────────────────────────────────
RESEND_API_KEY=

# ── Worker ──────────────────────────────────────────────────
# JOB_WORKDIR=/tmp/anoosh-jobs
# WORKER_POLL_INTERVAL_MS=5000
