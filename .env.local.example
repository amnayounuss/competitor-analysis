# ═══ Local Development — Self-Hosted Supabase ═══
# Copy to .env and fill in. Keys come from docker/scripts/setup.sh output.

# ── Supabase (self-hosted, from docker/scripts/setup.sh) ────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from setup.sh output>
SUPABASE_SERVICE_ROLE_KEY=<from setup.sh output>

# ── Google APIs ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
# GMB_OAUTH_CLIENT_ID=
# GMB_OAUTH_CLIENT_SECRET=

# ── Scraping ────────────────────────────────────────────────
APIFY_TOKEN=

# ── AI (Anthropic Claude) ──────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Email (optional for dev) ────────────────────────────────
# RESEND_API_KEY=

# ── Worker ──────────────────────────────────────────────────
# JOB_WORKDIR=/tmp/anoosh-jobs
# WORKER_POLL_INTERVAL_MS=5000
# SUPPRESS_REPORT_EMAIL=true
