############################################################
# Supabase Self-Hosted — Environment Configuration
# Copy to .env and fill in values. Run scripts/generate-keys.sh
# to auto-generate JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY.
############################################################

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-password
POSTGRES_DB=postgres
POSTGRES_PORT=54322

# ── JWT (run scripts/generate-keys.sh to generate) ──────────
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
JWT_EXPIRY=3600

# ── URLs ─────────────────────────────────────────────────────
# Kong API gateway — the public Supabase URL
API_EXTERNAL_URL=http://localhost:8000
API_EXTERNAL_PORT=8000

# Your Next.js app URL (used by GoTrue for redirects)
SITE_URL=http://localhost:3000

# ── Auth (GoTrue) ───────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_SIGN_INS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true
ADDITIONAL_REDIRECT_URLS=

# ── SMTP (for auth emails — optional in dev) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@localhost

# ── PostgREST ───────────────────────────────────────────────
# Client schemas are added dynamically via provision-client-schema
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── Studio ──────────────────────────────────────────────────
STUDIO_PORT=3001
STUDIO_DEFAULT_ORGANIZATION=CompetitorAnalysis
STUDIO_DEFAULT_PROJECT=Default

# ── Realtime ────────────────────────────────────────────────
REALTIME_SECRET_KEY_BASE=ChangeThisToAVeryLongRandomStringAtLeast64Characters
