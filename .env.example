# ───── Required (one-time, never changes) ─────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_ADMIN_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...

# ───── Optional ─────
# JOB_WORKDIR=/tmp/anoosh-jobs

# ───── Optional fallbacks (for local dev) ─────
# In production, manage these via /admin UI instead.

# Gmail OAuth (sender)
# GMAIL_USER=
# GMAIL_FROM_NAME=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# GMB OAuth (Business Profile API)
# GMB_OAUTH_CLIENT_ID=
# GMB_OAUTH_CLIENT_SECRET=
